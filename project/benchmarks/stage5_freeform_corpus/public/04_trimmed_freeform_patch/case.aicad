let base: Surface = bspline_surface(
    degree_u = 1,
    degree_v = 1,
    control_points = [
        [Point3(x = 0mm, y = 0mm, z = 0mm), Point3(x = 0mm, y = 100mm, z = 20mm)],
        [Point3(x = 100mm, y = 0mm, z = 20mm), Point3(x = 100mm, y = 100mm, z = 0mm)],
    ],
    knots_u = [0.0, 1.0],
    multiplicities_u = [2, 2],
    knots_v = [0.0, 1.0],
    multiplicities_v = [2, 2],
    weights = [[1.0, 1.0], [1.0, 1.0]],
    periodic_u = false,
    periodic_v = false,
);

// Trim loop is read directly as a (u, v) parameter-space curve (z must be
// numerically zero) -- a circle of radius 0.3 centered at (0.5, 0.5),
// entirely inside the base surface's own [0,1]x[0,1] natural domain.
let outer: Curve = circle_curve(
    center = Point3(x = 0.5m, y = 0.5m, z = 0m),
    normal = Vector3(x = 0.0, y = 0.0, z = 1.0),
    radius = 0.3m,
);
let trimmed: Surface = trim_surface(base, outer, [], 0.000001m);

// (0.6, 0.5) is 0.1 from the trim center -- inside the r=0.3 loop.
let trimmed_eval: SurfaceEvaluation = evaluate_surface(trimmed, 0.6, 0.5);
let base_eval: SurfaceEvaluation = evaluate_surface(base, 0.6, 0.5);
let trimmed_x: Length = trimmed_eval.point.x;
let trimmed_y: Length = trimmed_eval.point.y;
let trimmed_z: Length = trimmed_eval.point.z;
let base_x: Length = base_eval.point.x;
let base_y: Length = base_eval.point.y;
let base_z: Length = base_eval.point.z;
