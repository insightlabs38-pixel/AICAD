(* AICAD grammar — Stage 0 sketch, seeded from RFC-0001 §7.
   Informal and not exhaustive. This file becomes the authoritative,
   machine-checked grammar starting at Stage 2 (project/TASKS.yaml
   AICAD-039+), sharing a conformance test corpus with tree-sitter-aicad/
   per docs/plan/02_LANGUAGE_AND_COMPILER.md §18-19. Any change here
   requires a spec update, a positive test, a negative test, and a
   core-skill update if user-visible, per that same section.

   Patched by the independent Stage-0 review
   (project/reports/reviews/STAGE0-INDEPENDENT-REVIEW.md) to add
   if_expr/match_expr/block_expr, which the original sketch referenced
   (block_expr) or partially covered (if/match as statements only) but
   never fully defined, even though existing precedent
   (docs/plan/07_ASSEMBLIES_KINEMATICS_CONFIGURATIONS.md §10 and the
   Stage-0 paper example) already relies on if/match in expression
   position. No new syntax is introduced beyond RFC-0001 §4's "broadly
   Rust/TypeScript-like" framing (DL-1); no open OWNER_DECISIONS.md item is
   touched.

   Patched again (`AICAD-056`) to add list_expr/range_expr, per the owner
   ruling recorded at `project/OWNER_DECISIONS.md#D16` (positive test:
   `crates/cad-parser`'s `list_literal_*`/`*range*` tests; negative test:
   `range_operator_is_not_chainable`/`reports_missing_closing_bracket_in_
   list_literal`). Both are ordinary `expression` alternatives — no new
   statement/declaration syntax, no compiler intrinsic.

   Patched again (`AICAD-057B`) to add `type_params` to `fn_decl` (and,
   informally — this file has never formally defined `struct_decl`/
   `enum_decl` productions at all, only referenced them from `item`,
   above — to `struct_decl`/`enum_decl` in the same shape), per the owner
   ruling recorded at `project/OWNER_DECISIONS.md#D17`/`project/
   DECISION_LOG.md#DL-14` (positive test: `crates/cad-parser`'s
   `parses_generic_struct_with_one_type_parameter`/
   `parses_generic_struct_with_two_type_parameters`/
   `parses_generic_enum`/`parses_generic_function`; negative test:
   `reports_missing_closing_angle_bracket_on_type_param_list`/
   `reports_non_identifier_in_type_param_list`). An ordinary, additive
   optional type-parameter list on three existing declaration forms — no
   bounds, no variance, no defaults, no new expression/statement syntax. *)

program        = { item } ;
item           = let_decl | const_decl | param_decl
               | fn_decl | struct_decl | enum_decl | interface_decl
               | part_decl | assembly_decl | requirement_decl | test_decl
               | import_decl ;

block          = "{" , { statement } , "}" ;
statement      = let_stmt | var_stmt | assign_stmt | expr_stmt
               | if_stmt | for_stmt | while_stmt | loop_stmt
               | match_stmt | return_stmt | break_stmt | continue_stmt ;

let_stmt       = "let" , identifier , [ ":" , type ] , "=" , expression , ";" ;
var_stmt       = "var" , identifier , [ ":" , type ] , "=" , expression , ";" ;
assign_stmt    = identifier , "=" , expression , ";" ;   (* explicit rebind, RFC-0001 §5 *)
expr_stmt      = expression , ";" ;                       (* result discarded if unused *)

if_stmt        = "if" , expression , block , [ "else" , ( block | if_stmt ) ] ;
for_stmt       = "for" , identifier , "in" , expression , block ;
while_stmt     = "while" , expression , block ;
loop_stmt      = "loop" , block ;
match_stmt     = "match" , expression , "{" , { match_arm } , "}" ;
match_arm      = pattern , "=>" , ( expression , "," | block ) ;
return_stmt    = "return" , [ expression ] , ";" ;
break_stmt     = "break" , ";" ;
continue_stmt  = "continue" , ";" ;

fn_decl        = [ "pure" ] , "fn" , identifier , [ type_params ] ,
                 "(" , [ params ] , ")" , [ "->" , type ] , block ;
params         = param , { "," , param } ;
param          = identifier , ":" , type , [ "=" , expression ] ;

type_params    = "<" , identifier , { "," , identifier } , [","] , ">" ;
                 (* `project/OWNER_DECISIONS.md#D17`. Also accepted, in the
                    same shape, right after the declared name of a
                    (currently informally-specified) struct_decl/enum_decl.
                    Each parameter is a bare identifier only — no bounds
                    (`T: Interface`), defaults, variance, or lifetime
                    syntax; deliberately out of Stage-2 scope per that
                    ruling. *)

expression     = range_expr ;
range_expr     = or_expr , [ ( ".." | "..=" ) , or_expr ] ;
                 (* `project/OWNER_DECISIONS.md#D16`. Non-associative: at
                    most one range operator per range expression — a
                    second ".."/"..=" on either side is not part of this
                    production (e.g. "0..5..10" is "0..5" followed by
                    trailing tokens, a parse error), matching every worked
                    example in the owner ruling. *)
or_expr        = call_expr | method_call_expr | binary_expr | literal
               | identifier | "(" , expression , ")" | block_expr
               | if_expr | match_expr | list_expr ;
                 (* "or_expr" names this production's precedence level
                    (lowest of the non-range alternatives, `||`), not a
                    restriction to boolean-or expressions only — every
                    existing `expression` alternative from before
                    `AICAD-056` is reachable through the ordinary
                    precedence ladder `cad-parser`'s own module doc comment
                    documents (range -> or -> and -> equality ->
                    relational -> additive -> multiplicative -> unary ->
                    postfix -> primary). *)
list_expr      = "[" , [ expression , { "," , expression } , [","] ] , "]" ;
                 (* `project/OWNER_DECISIONS.md#D16`. Produces an immutable
                    List<T>; element-type unification is a type-checking
                    concern, not a grammar one (mirrors match_expr's own
                    "used in expression position when every arm yields a
                    value" division of labor, above). *)
block_expr     = "{" , { statement } , [ expression ] , "}" ;
                 (* optional trailing, non-semicolon-terminated expression
                    is the block's value *)
if_expr        = "if" , expression , block_expr ,
                 "else" , ( block_expr | if_expr ) ;
                 (* `else` required in expression position; an `if` with
                    no `else` remains valid only as if_stmt *)
match_expr     = "match" , expression , "{" , { match_arm } , "}" ;
                 (* same arm shape as match_stmt; used in expression
                    position when every arm yields a value *)
call_expr      = identifier , "(" , [ args ] , ")" ;                (* cut(body, hole) *)
method_call_expr
               = expression , "." , identifier , "(" , [ args ] , ")" ; (* body.cut(hole) — sugar, RFC-0001 §5 *)
args           = ( expression | named_arg ) , { "," , ( expression | named_arg ) } ;
named_arg      = identifier , "=" , expression ;

(* No indentation-sensitive productions exist anywhere in this grammar
   (RFC-0001 §4). No production infers a statement terminator — automatic
   semicolon insertion is not part of the language; a missing ";" is
   always a parse error. *)
